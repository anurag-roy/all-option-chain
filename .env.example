PORT=4000

# Database URL
DATABASE_URL=file:.data/database.db

# Kite Credentials
KITE_USER_ID=YOUR_KITE_USER_ID
KITE_PASSWORD=YOUR_KITE_PASSWORD
KITE_API_KEY=YOUR_KITE_API_KEY
KITE_API_SECRET=YOUR_KITE_API_SECRET
KITE_TOTP_SECRET=YOUR_KITE_TOTP_SECRET

# G-Sec curve: explicit app convention, stored with each daily CCIL snapshot.
GSEC_CURVE_DAY_COUNT=ACT/365
GSEC_CURVE_COMPOUNDING=continuous
GSEC_CURVE_MAX_AGE_DAYS=7
GSEC_RV_THRESHOLD_BP=5
